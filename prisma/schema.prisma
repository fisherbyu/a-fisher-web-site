// Prisma Schema Definition
// Connection Configurations
generator client {
    provider      = "prisma-client-js"
    binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

// Enums
// Postgres sorts enums by declaration order (S first)
enum Tier {
    S
    A
    B
    C
}

// Table Definitions
// Supertype for Artist and Album (Shared Primary Key)
model MusicItem {
    id        Int      @id @default(autoincrement())
    imageId   Int?
    linkId    Int      @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    image          Asset?           @relation(fields: [imageId], references: [id], onDelete: SetNull)
    // Restrict: a Link can't be deleted while a MusicItem references it
    link           Link             @relation(fields: [linkId], references: [id], onDelete: Restrict)
    artist         Artist?
    album          Album?
    genres         MusicItemGenre[]
    rankingEntries RankingEntry[]

    // Indexes
    @@index([imageId])
}

model Artist {
    id             Int      @id
    name           String   @db.VarChar(100)
    contents       String[] @default([])
    favoriteTracks String[] @default([])
    favoriteAlbums String[] @default([])
    updatedAt      DateTime @updatedAt

    // Relations (Subtype of MusicItem, Cascade Deletions)
    musicItem    MusicItem     @relation(fields: [id], references: [id], onDelete: Cascade)
    albums       Album[]
    rankingLists RankingList[]

    // Indexes
    @@index([name])
}

model Album {
    id             Int       @id
    title          String    @db.VarChar(100)
    releaseDate    DateTime? @db.Date
    artistId       Int
    contents       String[]  @default([])
    favoriteTracks String[]  @default([])
    updatedAt      DateTime  @updatedAt

    // Relations (Subtype of MusicItem, Cascade Deletions)
    musicItem MusicItem @relation(fields: [id], references: [id], onDelete: Cascade)
    // Restrict: Album MusicItems must be deleted before their Artist
    artist    Artist    @relation(fields: [artistId], references: [id], onDelete: Restrict)

    // Constraints
    @@unique([artistId, title], name: "artist_album_title")
    // Indexes
    @@index([title])
}

model Genre {
    id        Int      @id @default(autoincrement())
    name      String   @unique @db.VarChar(50)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    musicItems MusicItemGenre[]
}

model MusicItemGenre {
    musicItemId Int
    genreId     Int

    // Relations (Join Table, Cascade Deletions)
    musicItem MusicItem @relation(fields: [musicItemId], references: [id], onDelete: Cascade)
    genre     Genre     @relation(fields: [genreId], references: [id], onDelete: Cascade)

    // Constraints
    @@id([musicItemId, genreId])
    // Indexes
    @@index([genreId])
}

model Playlist {
    id        Int      @id @default(autoincrement())
    title     String   @db.VarChar(100)
    linkId    Int      @unique
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations (Restrict: a Link can't be deleted while a Playlist references it)
    link Link @relation(fields: [linkId], references: [id], onDelete: Restrict)

    // Indexes
    @@index([title])
}

model Link {
    id         Int      @id @default(autoincrement())
    appleURI   String   @db.VarChar(255)
    spotifyURI String   @db.VarChar(255)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    // Relations (Owners Reference Link)
    musicItem MusicItem?
    playlist  Playlist?
}

// Rankings
model RankingList {
    id        Int      @id @default(autoincrement())
    name      String   @db.VarChar(100)
    slug      String   @unique @db.VarChar(100)
    // Scope: set for an Artist's album ranking, null for general lists
    artistId  Int?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations (Cascade Deletions)
    artist  Artist?        @relation(fields: [artistId], references: [id], onDelete: Cascade)
    entries RankingEntry[]

    // Indexes
    @@index([artistId])
}

model RankingEntry {
    id          Int      @id @default(autoincrement())
    listId      Int
    musicItemId Int
    tier        Tier?
    position    Int?
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations (Cascade Deletions)
    list      RankingList @relation(fields: [listId], references: [id], onDelete: Cascade)
    musicItem MusicItem   @relation(fields: [musicItemId], references: [id], onDelete: Cascade)

    // Constraints
    @@unique([listId, musicItemId], name: "list_item")
    @@unique([listId, tier, position], name: "list_tier_position")
    // Indexes
    @@index([musicItemId])
}

// Assets
// Files live at {folder}/{key}/{name}-{width}.webp under MEDIA_ROOT
// TODO(contract): folder, key, name, blurDataUrl become required and src is dropped after the backfill
model Asset {
    id          Int      @id @default(autoincrement())
    // Legacy Supabase bucket path, read by the backfill
    src         String?  @db.VarChar(255)
    // Validated against a code constant: "photo", "music/artist", "music/album"
    folder      String?  @db.VarChar(50)
    // Random and immutable; replacing the file generates a new key on the same row
    key         String?  @unique @db.VarChar(20)
    // Slug, e.g. "delicate-arch"
    name        String?  @db.VarChar(100)
    width       Int      @db.Integer
    height      Int      @db.Integer
    blurDataUrl String?  @db.Text
    alt         String   @db.VarChar(255)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations (Owners Reference Asset)
    musicItems MusicItem[]
    photo      Photo?
}

model Photo {
    id        Int       @id @default(autoincrement())
    assetId   Int       @unique
    title     String    @db.VarChar(100)
    caption   String?   @db.Text
    camera    String?   @db.VarChar(100)
    takenAt   DateTime? @db.Date
    location  String?   @db.VarChar(100)
    published Boolean   @default(false)
    sortOrder Int       @default(0)
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    // Relations (Cascade: a Photo can't exist without its file)
    asset Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
    tags  PhotoTag[]

    // Indexes
    @@index([published, sortOrder])
}

model Tag {
    id        Int      @id @default(autoincrement())
    name      String   @unique @db.VarChar(50)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    photos PhotoTag[]
}

model PhotoTag {
    photoId Int
    tagId   Int

    // Relations (Join Table, Cascade Deletions)
    photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)
    tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

    // Constraints
    @@id([photoId, tagId])
    // Indexes
    @@index([tagId])
}
